# Passed to test installation
CC="gcc"
CXX="g++"
CFLAGS=""
CXXFLAGS=""

# Static test configurations
BASELINE_CFLAGS="-fno-stack-protector -fno-pie"
BASELINE_LDFLAGS="-no-pie -z execstack"

CANARY_CFLAGS="-fno-pie"
CANARY_LDFLAGS="-no-pie -z execstack"

DEP_CFLAGS="-fno-stack-protector -fno-pie"
DEP_LDFLAGS="-no-pie"

PIE_CFLAGS="-fno-stack-protector"
PIE_LDFLAGS="-z execstack"

# Important container variables
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/phoronix-test-suite:/usr/local/go/bin

# Phoronix settings
FORCE_INSTALL=1
INSTALL_SIZES_ARE_A_BENCHMARK=1
PHOROMATIC_HTTP_PORT=8000
PTS_WEBSOCKET_PORT=8001
NGINX_PORT=8089